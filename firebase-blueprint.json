      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "High-entropy capability report ID (rpt-...)", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "description": "Company header name", "maxLength": 160 },
        "companySubTitle": { "type": "string", "description": "Company subtitle", "maxLength": 240 },
        "companyAddress": { "type": "string", "description": "Company address", "maxLength": 300 },
        "companyPhone": { "type": "string", "description": "Company phone", "maxLength": 32 },
        "companyEmail": { "type": "string", "description": "Company email", "maxLength": 160 },
        "companyLogoUrl": { "type": "string", "description": "Company logo URL or path", "maxLength": 150000 },
        "periodType": { "type": "string", "description": "daily, monthly, yearly, custom, or all", "enum": ["daily", "monthly", "yearly", "custom", "all"] },
        "periodLabel": { "type": "string", "description": "Human-readable Bengali period label", "maxLength": 160 },
        "verificationCode": { "type": "string", "description": "Official verification code", "maxLength": 64 },
        "auditScore": { "type": "number", "description": "Statement audit completeness score" },
        "generatedAt": { "type": "string", "description": "ISO timestamp when snapshot was generated", "maxLength": 64 },
        "generatedBy": { "type": "string", "description": "Name of generator", "maxLength": 120 },
        "summary": { "type": "object", "description": "Aggregated totals (totalIncome, totalExpense, netBalance, txCount, pendingDue)" },
        "categorySummary": { "type": "array", "description": "Category breakdown entries" },
        "multiMonthSummary": { "type": "array", "description": "Monthly breakdown entries for yearly/multi-month views" },
        "transactions": { "type": "array", "description": "Sanitized non-PII financial ledger rows" },
        "signatories": { "type": "object", "description": "Director, Manager, and Auditor signatory names and designations" }
      },
      "required": ["id", "companyName", "periodType", "periodLabel", "verificationCode", "generatedAt", "summary", "transactions"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Lightweight server connectivity probe document",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean", "description": "Health indicator" }
      }
    }
  },
